class ConfiguracionBiblioteca {
private static ConfiguracionBiblioteca instancia = null;
    private String nombre;
    private int maxLibros;
    private int plazoDias;

private ConfiguracionBiblioteca() {
nombre = "Biblioteca Central";
maxLibros = 3;
plazoDias = 14;
}
public static ConfiguracionBiblioteca obtenerInstancia() {
  if (instancia == null) {
instancia = new ConfiguracionBiblioteca();
}
return instancia;
}

public String getNombre() {
return nombre;
}
public int getMaxLibros() {
return maxLibros;
}
public int getPlazoDias() {
return plazoDias;
}
public void setNombre(String nuevoNombre) {
  if (nuevoNombre == null || nuevoNombre.trim().isEmpty()) {
System.out.println("Error: el nombre no puede estar vacío.");
return;
}
nombre = nuevoNombre;
}
public void setMaxLibros(int nuevoMax) {
  if (nuevoMax <= 0) {
System.out.println("Error: el máximo de libros debe ser mayor que cero.");
return;
}
maxLibros = nuevoMax;
}
public void setPlazoDias(int nuevoPlazo) {
  if (nuevoPlazo <= 0) {
System.out.println("Error: el plazo debe ser mayor que cero.");
return;
}
plazoDias = nuevoPlazo;
}
}
class ModuloPrestamos {
private ConfiguracionBiblioteca config;
public ModuloPrestamos() {
config = ConfiguracionBiblioteca.obtenerInstancia();
}
public ConfiguracionBiblioteca getConfig() {
  return config;
}
public void mostrarReglas() {
  System.out.println("[Préstamos] Máximo de libros por socio: " + config.getMaxLibros()
    + " | Plazo de devolución: " + config.getPlazoDias() + " días");
}
}
class ModuloConsultas {
private ConfiguracionBiblioteca config;
 public ModuloConsultas() {
config = ConfiguracionBiblioteca.obtenerInstancia();
}

public ConfiguracionBiblioteca getConfig() {
return config;
}
public void mostrarInformacion() {
System.out.println("[Consultas] Biblioteca: " + config.getNombre()
    + " | Máximo de libros: " + config.getMaxLibros()
    + " | Plazo: " + config.getPlazoDias() + " días");
}
}

public class Main {
  public static void main(String[] args) {

ModuloPrestamos prestamos = new ModuloPrestamos();
ModuloConsultas consultas = new ModuloConsultas();

System.out.println("--- Valores iniciales ---");
prestamos.mostrarReglas();
consultas.mostrarInformacion();

ConfiguracionBiblioteca config = ConfiguracionBiblioteca.obtenerInstancia();
config.setNombre("Biblioteca Municipal");
config.setMaxLibros(5);
config.setPlazoDias(21);

System.out.println("--- Después de modificar la configuración ---");
prestamos.mostrarReglas();
consultas.mostrarInformacion();

System.out.println("--- Valores inválidos ---");
config.setNombre("   ");
config.setMaxLibros(0);
config.setPlazoDias(-3);
consultas.mostrarInformacion();

System.out.println("¿Usan el mismo objeto? " + (prestamos.getConfig() == consultas.getConfig()));
}
}
